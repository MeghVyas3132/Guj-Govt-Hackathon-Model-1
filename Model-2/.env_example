# ─── Sentinel camera sandbox ──────────────────────────────────────────────────
SENTINEL_PASSWORD=
SENTINEL_BASE_URL=https://cctv.corp8.cloud
# RTSP is primary (no auth, direct IP). If port 8554 is blocked, worker falls back to HLS.
SENTINEL_RTSP_BASE=rtsp://103.250.160.189:8554/stream

# Cameras to process — comma-separated IDs, or "all" for all 30.
# Start with 6 for dev; expand once the pipeline is stable.
CAMERAS=cam04,cam05,cam06,cam08,cam12,cam18

# How many frames to skip between processed frames (5 = process every 5th frame ≈ 6 FPS).
# Lower = more detections + more GPU load. Start at 5, tune after profiling.
FRAME_SKIP=5

# ─── AI models ────────────────────────────────────────────────────────────────
YOLO_MODEL=yolov8s.pt
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=openai
PLATE_MODEL=FarAwayFer/yolov8n_license_plate_recognition
PLATE_OCR_MODEL=global-plates-mobile-vit-v2-model
# Minimum OCR confidence to accept a plate reading (0–1).
PLATE_CONF_THRESHOLD=0.25
# Minimum YOLO detection confidence to process a box.
DETECTION_CONF_THRESHOLD=0.35

# ─── Database (pgvector) ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://setu:setu_dev_only@127.0.0.1:5433/setu

# ─── MinIO / S3-compatible object storage ────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=setu
MINIO_SECRET_KEY=setu_dev_only
MINIO_BUCKET=setu-clips
MINIO_SECURE=false

# ─── Watchlist alert thresholds ───────────────────────────────────────────────
# Cosine similarity threshold for embedding-based watchlist matching (0–1).
# 0.75 is the starting point from DATA_MODEL.md — tune after real embeddings are produced.
WATCHLIST_EMBED_THRESHOLD=0.75
