# Copy to .env and adjust. Every value here has a working default in app/core/config.py.

DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
REDIS_URL=redis://localhost:6379

# postgis/postgis publishes amd64 only, so it runs under Rosetta emulation on Apple
# Silicon (works, but slower container startup). For a native arm64 build, uncomment:
# POSTGIS_IMAGE=imresamu/postgis:16-3.4

# Sentinel sandbox (Plan 1 Task 9 / Plan 2 Task 8). The catalogue sits behind a
# session cookie obtained by signing in at sentinel.gujarat.gov.in.
SENTINEL_CATALOGUE_URL=https://cctv.corp8.cloud/cameras.json
# SENTINEL_SESSION_COOKIE=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_BASEMAP=pmtiles
