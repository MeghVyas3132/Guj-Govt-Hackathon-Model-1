{
    "openapi": "3.1.0",
    "info": {
        "title": "Sentinel CCTV Registry",
        "description": "Model 1 \u2014 Centralised CCTV Registry & GIS Foundation.",
        "version": "1.0.0"
    },
    "paths": {
        "/healthz": {
            "get": {
                "tags": [
                    "system"
                ],
                "summary": "Healthz",
                "operationId": "healthz_healthz_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "additionalProperties": {
                                        "type": "string"
                                    },
                                    "type": "object",
                                    "title": "Response Healthz Healthz Get"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/cameras": {
            "get": {
                "tags": [
                    "cameras"
                ],
                "summary": "List and filter cameras",
                "operationId": "list_cameras_api_v1_cameras_get",
                "parameters": [
                    {
                        "name": "limit",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "maximum": 500,
                            "default": 50,
                            "title": "Limit"
                        }
                    },
                    {
                        "name": "offset",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 0,
                            "default": 0,
                            "title": "Offset"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Page_CameraRead_"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/cameras/{camera_id}": {
            "get": {
                "tags": [
                    "cameras"
                ],
                "summary": "Get Camera",
                "operationId": "get_camera_api_v1_cameras__camera_id__get",
                "parameters": [
                    {
                        "name": "camera_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid",
                            "title": "Camera Id"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CameraRead"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/cameras/{camera_id}/streams": {
            "get": {
                "tags": [
                    "cameras"
                ],
                "summary": "Stream endpoints for this camera",
                "description": "Entry point for Models 2-4. Prefer the endpoint whose reachability matches your network: public_cdn works anywhere, direct_ip needs gateway ports open.",
                "operationId": "get_camera_streams_api_v1_cameras__camera_id__streams_get",
                "parameters": [
                    {
                        "name": "camera_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid",
                            "title": "Camera Id"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/StreamEndpointRead"
                                    },
                                    "title": "Response Get Camera Streams Api V1 Cameras  Camera Id  Streams Get"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "CameraRead": {
                "properties": {
                    "external_camera_id": {
                        "type": "string",
                        "title": "External Camera Id",
                        "examples": [
                            "cam04"
                        ]
                    },
                    "name": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Name",
                        "examples": [
                            "Nehru Bridge East Approach"
                        ]
                    },
                    "latitude": {
                        "type": "number",
                        "maximum": 90.0,
                        "minimum": -90.0,
                        "title": "Latitude",
                        "examples": [
                            23.0225
                        ]
                    },
                    "longitude": {
                        "type": "number",
                        "maximum": 180.0,
                        "minimum": -180.0,
                        "title": "Longitude",
                        "examples": [
                            72.5714
                        ]
                    },
                    "address": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Address"
                    },
                    "camera_type": {
                        "$ref": "#/components/schemas/CameraType",
                        "default": "fixed"
                    },
                    "camera_technology": {
                        "$ref": "#/components/schemas/CameraTechnology",
                        "default": "ip"
                    },
                    "azimuth_deg": {
                        "anyOf": [
                            {
                                "type": "number",
                                "exclusiveMaximum": 360.0,
                                "minimum": 0.0
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Azimuth Deg",
                        "examples": [
                            135.0
                        ]
                    },
                    "fov_deg": {
                        "anyOf": [
                            {
                                "type": "number",
                                "maximum": 360.0,
                                "exclusiveMinimum": 0.0
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Fov Deg",
                        "examples": [
                            90.0
                        ]
                    },
                    "range_m": {
                        "anyOf": [
                            {
                                "type": "number",
                                "exclusiveMinimum": 0.0
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Range M",
                        "examples": [
                            100.0
                        ]
                    },
                    "height_m": {
                        "anyOf": [
                            {
                                "type": "number",
                                "exclusiveMinimum": 0.0
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Height M"
                    },
                    "resolution": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Resolution"
                    },
                    "has_night_vision": {
                        "anyOf": [
                            {
                                "type": "boolean"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Has Night Vision"
                    },
                    "connectivity": {
                        "$ref": "#/components/schemas/Connectivity",
                        "default": "unknown"
                    },
                    "storage_type": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Storage Type",
                        "examples": [
                            "local"
                        ]
                    },
                    "retention_days": {
                        "anyOf": [
                            {
                                "type": "integer",
                                "minimum": 0.0
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Retention Days",
                        "examples": [
                            15
                        ]
                    },
                    "ownership_class": {
                        "$ref": "#/components/schemas/OwnershipClass",
                        "default": "government"
                    },
                    "site_type": {
                        "$ref": "#/components/schemas/SiteType",
                        "default": "other"
                    },
                    "amc_vendor": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Amc Vendor"
                    },
                    "amc_expiry_date": {
                        "anyOf": [
                            {
                                "type": "string",
                                "format": "date"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Amc Expiry Date"
                    },
                    "install_date": {
                        "anyOf": [
                            {
                                "type": "string",
                                "format": "date"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Install Date"
                    },
                    "metadata": {
                        "additionalProperties": true,
                        "type": "object",
                        "title": "Metadata",
                        "description": "Department-specific fields with no canonical home. Never dropped."
                    },
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "title": "Id"
                    },
                    "camera_uid": {
                        "type": "string",
                        "title": "Camera Uid",
                        "examples": [
                            "GJ-POL-000123"
                        ]
                    },
                    "department_id": {
                        "type": "string",
                        "format": "uuid",
                        "title": "Department Id"
                    },
                    "department_code": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Department Code",
                        "examples": [
                            "POL"
                        ]
                    },
                    "operator_department_id": {
                        "anyOf": [
                            {
                                "type": "string",
                                "format": "uuid"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Operator Department Id"
                    },
                    "district_id": {
                        "anyOf": [
                            {
                                "type": "string",
                                "format": "uuid"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "District Id"
                    },
                    "current_status": {
                        "$ref": "#/components/schemas/CameraStatus",
                        "default": "unknown"
                    },
                    "status_since": {
                        "anyOf": [
                            {
                                "type": "string",
                                "format": "date-time"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Status Since"
                    },
                    "last_seen_at": {
                        "anyOf": [
                            {
                                "type": "string",
                                "format": "date-time"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Last Seen At"
                    },
                    "lifecycle_state": {
                        "$ref": "#/components/schemas/LifecycleState",
                        "default": "active"
                    },
                    "source_type": {
                        "$ref": "#/components/schemas/SourceType"
                    },
                    "stream_endpoints": {
                        "items": {
                            "$ref": "#/components/schemas/StreamEndpointRead"
                        },
                        "type": "array",
                        "title": "Stream Endpoints"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Updated At"
                    }
                },
                "type": "object",
                "required": [
                    "external_camera_id",
                    "latitude",
                    "longitude",
                    "id",
                    "camera_uid",
                    "department_id",
                    "source_type",
                    "created_at",
                    "updated_at"
                ],
                "title": "CameraRead"
            },
            "CameraStatus": {
                "type": "string",
                "enum": [
                    "online",
                    "offline",
                    "unknown",
                    "maintenance"
                ],
                "title": "CameraStatus"
            },
            "CameraTechnology": {
                "type": "string",
                "enum": [
                    "analog",
                    "ip",
                    "unknown"
                ],
                "title": "CameraTechnology"
            },
            "CameraType": {
                "type": "string",
                "enum": [
                    "fixed",
                    "ptz",
                    "dome",
                    "bullet",
                    "anpr",
                    "thermal",
                    "other"
                ],
                "title": "CameraType"
            },
            "Connectivity": {
                "type": "string",
                "enum": [
                    "fiber",
                    "4g",
                    "5g",
                    "wifi",
                    "lan",
                    "unknown"
                ],
                "title": "Connectivity"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "LifecycleState": {
                "type": "string",
                "enum": [
                    "active",
                    "decommissioned"
                ],
                "title": "LifecycleState"
            },
            "OwnershipClass": {
                "type": "string",
                "enum": [
                    "government",
                    "private",
                    "ppp"
                ],
                "title": "OwnershipClass"
            },
            "Page_CameraRead_": {
                "properties": {
                    "items": {
                        "items": {
                            "$ref": "#/components/schemas/CameraRead"
                        },
                        "type": "array",
                        "title": "Items"
                    },
                    "total": {
                        "type": "integer",
                        "title": "Total",
                        "description": "Total rows matching the filter, ignoring pagination."
                    },
                    "limit": {
                        "type": "integer",
                        "title": "Limit"
                    },
                    "offset": {
                        "type": "integer",
                        "title": "Offset"
                    }
                },
                "type": "object",
                "required": [
                    "items",
                    "total",
                    "limit",
                    "offset"
                ],
                "title": "Page[CameraRead]"
            },
            "Reachability": {
                "type": "string",
                "enum": [
                    "public_cdn",
                    "direct_ip",
                    "lan_only"
                ],
                "title": "Reachability"
            },
            "SiteType": {
                "type": "string",
                "enum": [
                    "traffic_junction",
                    "godown",
                    "pds_shop",
                    "rto_checkpoint",
                    "office",
                    "hospital",
                    "bus_depot",
                    "border_checkpost",
                    "public_space",
                    "other"
                ],
                "title": "SiteType"
            },
            "SourceType": {
                "type": "string",
                "enum": [
                    "csv",
                    "manual",
                    "api",
                    "adapter"
                ],
                "title": "SourceType"
            },
            "StreamEndpointRead": {
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "title": "Id"
                    },
                    "protocol": {
                        "$ref": "#/components/schemas/StreamProtocol"
                    },
                    "url": {
                        "type": "string",
                        "title": "Url",
                        "examples": [
                            "rtsp://103.250.160.189:8554/stream/cam04"
                        ]
                    },
                    "codec": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Codec",
                        "examples": [
                            "h264"
                        ]
                    },
                    "resolution": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Resolution",
                        "examples": [
                            "1920x1080"
                        ]
                    },
                    "is_primary": {
                        "type": "boolean",
                        "title": "Is Primary",
                        "default": true
                    },
                    "reachability": {
                        "$ref": "#/components/schemas/Reachability",
                        "description": "public_cdn works on any network; direct_ip needs gateway ports open."
                    },
                    "requires_auth": {
                        "type": "boolean",
                        "title": "Requires Auth",
                        "default": false
                    },
                    "verified_at": {
                        "anyOf": [
                            {
                                "type": "string",
                                "format": "date-time"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Verified At"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "protocol",
                    "url",
                    "reachability"
                ],
                "title": "StreamEndpointRead",
                "description": "How Models 2-4 reach this camera. Credentials are omitted unless the caller\nholds the streams:credentials scope."
            },
            "StreamProtocol": {
                "type": "string",
                "enum": [
                    "rtsp",
                    "hls",
                    "whep",
                    "onvif",
                    "snapshot"
                ],
                "title": "StreamProtocol"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    },
                    "input": {
                        "title": "Input"
                    },
                    "ctx": {
                        "type": "object",
                        "title": "Context"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}
